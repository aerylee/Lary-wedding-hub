# Public — safe in the browser. Row-level security is what protects data.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Server only — set as Edge Function secrets (supabase secrets set …), NEVER as VITE_* vars.
# SUPABASE_SERVICE_ROLE_KEY=
# MODEL_API_KEY=

# Optional: Google Maps address search in the guest editor. A *browser* key — restrict it in
# Google Cloud to your site's URLs and to "Maps JavaScript API" + "Places API (New)".
# Leave empty to use the offline address tools only.
VITE_GOOGLE_MAPS_API_KEY=
